  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.26.0",
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.51.1",
    "cpy-cli": "^5.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "playwright": "^1.51.1",
    "ts-node": "^10.9.2",
